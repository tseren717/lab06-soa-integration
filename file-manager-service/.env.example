# DigitalOcean Spaces credentials
# API -> Tokens -> Spaces Keys хэсгээс авна
SPACES_ACCESS_KEY=your_spaces_access_key_here
SPACES_SECRET_KEY=your_spaces_secret_key_here

# Bucket нэр (Create -> Spaces дээр өгсөн нэр)
SPACES_BUCKET=your-bucket-name

# Бүс (sgp1 = Singapore, nyc3 = New York, ams3 = Amsterdam)
SPACES_REGION=sgp1

# SOAP service URL (cloud deploy хийсний дараа шинэчлэнэ)
SOAP_WSDL_URL=http://localhost:4000/soap?wsdl

# Port
PORT=5001
